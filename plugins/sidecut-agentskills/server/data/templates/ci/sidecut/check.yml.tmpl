name: Check
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  # Picks where check runs on a pull request: the {{ciOwnLane}} light lane while it has a free
  # runner, otherwise a GitHub-hosted machine (SidecutStudio/sidecut-ops README, "Runner picker").
  # Pushes to main, dispatched runs and air mode skip it and run on the light lane.
  runner:
    if: github.event_name == 'pull_request' && !contains(vars.SIDECUT_RUNNER_MODE, 'air')
    runs-on: ubuntu-slim
    timeout-minutes: 5
    outputs:
      runs-on: ${{ steps.pick.outputs.runs-on }}
    steps:
      - id: pick
        uses: SidecutStudio/sidecut-ops/.github/actions/pick-runner@c575cb5b82a695ca2b91e3dafdcd4a5d8602ac9a # v3.7.0
        with:
          mode: ${{ vars.SIDECUT_RUNNER_MODE }}
          client-id: ${{ vars.SIDECUT_CI_CLIENT_ID }}
          app-key: {{ciAppKey}}
  check:
    needs: runner
    # A skipped or failed picker must not skip this job, since GitHub counts a skipped required
    # check as passed; without the picker's answer it runs on the light lane.
    if: ${{ !cancelled() }}
    runs-on: ${{ fromJSON(needs.runner.outputs.runs-on || {{ciLightRunner}}) }}
    timeout-minutes: 15
    steps:
      # A full clone, so the secret scan can read every commit this one reaches.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24.22.2
          cache: npm
      - run: npm ci
      - run: npm run check
      # TruffleHog at the pin in sidecut-ops' tools.json, with no Bun, failing on any secret this commit reaches.
      - uses: SidecutStudio/sidecut-ops/.github/actions/scan-secrets@9faa06eb176c33347f4ecd70bb47eaec079bb256 # v3.10.0
