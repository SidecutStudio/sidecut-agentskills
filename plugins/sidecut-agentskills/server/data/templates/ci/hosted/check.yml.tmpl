name: Check
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
# Every job runs on GitHub-hosted Linux, which is free for public repos. A public repo must never
# reach {{ciOwnLane}} runners: a fork's pull request could run code there.
jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 24.22.2
          cache: npm
      - run: npm ci
      - run: npm run check
  secrets:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      # trufflehog's pinned release build, checked against its published checksum.
      - name: Install trufflehog 3.99.2
        run: |
          {{secretScanInstall}}
      - run: trufflehog git "file://$PWD" --branch HEAD --results=verified,unknown --fail --no-update
  # The one check to require in branch protection. It always runs, since GitHub counts a skipped
  # required check as passed, and fails unless every job above succeeded.
  gate:
    name: gate
    needs: [check, secrets]
    if: always()
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - name: Every needed job succeeded
        env:
          NEEDS: ${{ toJSON(needs) }}
        run: |
          set -eu
          {
            echo '| Job | Result |'
            echo '| --- | --- |'
            jq -r 'to_entries[] | "| \(.key) | \(.value.result) |"' <<<"$NEEDS"
          } >> "$GITHUB_STEP_SUMMARY"
          bad=$(jq -r 'to_entries[] | select(.value.result != "success") | "\(.key) \(.value.result)"' <<<"$NEEDS")
          if [ -n "$bad" ]; then echo "Failed: $bad"; exit 1; fi
          echo "All needed jobs passed."
