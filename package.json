{
  "name": "sidecut-agentskills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "bin": {
    "sidecut-check": "bin/check.mjs",
    "sidecut-icon": "bin/icon.mjs",
    "sidecut-sync": "bin/sync.mjs"
  },
  "scripts": {
    "build": "node scripts/build-server.ts && node scripts/build-cli.ts",
    "check": "biome check . && tsc --noEmit && npm run style && npm test && node scripts/build-server.ts --check && node scripts/build-cli.ts --check",
    "fix": "biome check --write .",
    "icon": "node scripts/icon.ts",
    "new": "node scripts/new.ts",
    "style": "node scripts/check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "lucide-static": "1.72.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "esbuild": "0.28.2",
    "vitest": "5.1.1",
    "smol-toml": "1.9.1"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
