{
  "name": "sidecut-agentskills",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "sidecut-check": "scripts/check.ts"
  },
  "scripts": {
    "build": "bun scripts/build-server.ts",
    "check": "biome check . && tsc --noEmit && bun run style && bun test && bun scripts/build-server.ts --check",
    "fix": "biome check --write .",
    "new": "bun scripts/new.ts",
    "style": "bun scripts/check.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
